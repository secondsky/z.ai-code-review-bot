# Example workflow: interactive /zai commands on pull request comments.
#
# THIS is the authorization constraint that stops "some random person with a PR"
# from running commands and burning your Z.ai API key: the `if:` gate below runs
# BEFORE the job starts, before any checkout, secret, or our code. It uses
# GitHub's authoritative `author_association` to allow only trusted collaborators
# (OWNER / MEMBER / COLLABORATOR) — repo owner, organization members, and
# collaborators (including code owners who hold a repo role).
#
# Why issue_comment + author_association (and NOT pull_request_target):
#   - /zai commands are PR comments -> they fire `issue_comment` events.
#   - A drive-by commenter on a FORK pull request CAN trigger issue_comment, and
#     the GITHUB_TOKEN CAN write that fork PR's conversation. Without this gate,
#     a random person could run /zai ask and spend your Z.ai credits.
#   - This `if:` gate blocks them before the job starts: no runner minutes, no
#     reaction, no secret surface.
#   - Do NOT use pull_request_target for commands — it's a secret-exfiltration
#     footgun. Auto-review uses plain pull_request; commands use issue_comment
#     plus this gate.
#
# Defense in depth: the action ALSO re-checks authorization in code
# (ZAI_AUTH_THRESHOLD, default 'write') so a misconfigured workflow cannot let an
# untrusted user through. Both layers must agree for a command to run.
#
# Copy into .github/workflows/ and pin the `uses:` line to a published release
# (full commit SHA — see the security note next to the step).

name: Z.ai Commands

on:
  issue_comment:
    types: [created]

permissions:
  pull-requests: write
  contents: read     # bump to 'write' only if you later enable PR-body features

# Serialize commands per PR so two rapid /zai comments don't race. We do NOT
# cancel in-progress (cancel-in-progress: false): a queued /zai ask should not
# be dropped just because another command is running. This is the primary
# rate-limit / cost-abuse control; combine with ZAI_AUTH_THRESHOLD to limit who
# can trigger commands at all.
concurrency:
  group: zai-commands-pr-${{ github.event.issue.number }}
  cancel-in-progress: false

jobs:
  command:
    # ── PRIMARY AUTHORIZATION GATE ──────────────────────────────────────────
    # Only PR comments, and only from trusted collaborators. Edit the JSON list
    # to match ZAI_AUTH_THRESHOLD:
    #   write (default): OWNER, MEMBER, COLLABORATOR
    #   maintain:        OWNER, MEMBER
    #   admin:            OWNER
    #   read:             OWNER, MEMBER, COLLABORATOR, CONTRIBUTOR
    if: >-
      ${{ github.event.issue.pull_request != null
          && contains(fromJson('["OWNER","MEMBER","COLLABORATOR"]'),
                       github.event.comment.author_association) }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      # SECURITY: pin the action to the FULL commit SHA of the release tag —
      # not the mutable tag. Force-pushed tags were the propagation vector of
      # the 2025-2026 tj-actions/changed-files (CVE-2025-30066) and aqua Trivy
      # action supply-chain compromises:
      #   uses: <your-org>/z.ai-code-review-bot@<full-commit-sha> # v2.0.0
      # Keep the pin current with Dependabot's `github-actions` ecosystem
      # (.github/dependabot.yml):
      #   version: 2
      #   updates:
      #     - package-ecosystem: github-actions
      #       directory: /
      #       schedule: { interval: weekly }
      - name: Run /zai command
        uses: <your-org>/z.ai-code-review-bot@v2.0.0
        with:
          ZAI_API_KEY: ${{ secrets.ZAI_API_KEY }}
          ZAI_COMMANDS_ENABLED: 'true'
          # ZAI_AUTH_THRESHOLD: 'write'      # in-code re-check (default)
          # ZAI_ALLOW_FORK_COMMANDS: 'false' # block fork PR commands (default)
